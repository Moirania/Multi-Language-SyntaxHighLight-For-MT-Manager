// require MT >= 2.16.0
{
    name: ["Markdown (Dracula)", ".md", ".markdown", ".mdown"]
    hide: false
    ignoreCase: false
    styles: [
        "default", #1e1b19, #f8f8f2
        "heading", #d32f2f, #ff79c6, @B
        "bold", #6f5a4a, #ff79c6, @B
        "italic", #ba68c8, #bd93f9, @I
        "code", #558b2f, #f1fa8c
        "code_block", #558b2f, #f1fa8c
        "link", #1976d2, #8be9fd, @U
        "quote", #9e9e9e, #6272a4, @I
        "list", #d32f2f, #ff79c6, @B
        "hr", #9e9e9e, #6272a4
    ]
    contains: [
        // 1. 代码块 (必须放在最前，防止内部内容被其他规则匹配)
        {
            start: {match: /(?m)^```/}
            end: {match: /(?m)^```/}
            style: "code_block"
        }
        // 2. 标题
        {match: /(?m)^#{1,6}\s+.*$/, 0: "heading"}
        // 3. 引用块
        {match: /(?m)^>\s+.*$/, 0: "quote"}
        // 4. 分割线
        {match: /(?m)^(?:---|\*\*\*|___)\s*$/, 0: "hr"}
        // 5. 粗体 **text** 或 __text__
        {match: /\*\*[^*]+\*\*/, 0: "bold"}
        {match: /__[^_]+__/, 0: "bold"}
        // 6. 斜体 *text* 或 _text_ (使用环视排除粗体)
        {match: /(?<!\*)\*(?!\*)[^*]+\*(?!\*)/, 0: "italic"}
        {match: /(?<!_)_(?!_)[^_]+_(?!_)/, 0: "italic"}
        // 7. 行内代码 `code`
        {match: /`[^`]+`/, 0: "code"}
        // 8. 链接 [text](url)
        {match: /\[[^\]]+\]\([^)]+\)/, 0: "link"}
        // 9. 列表项标记
        {match: /(?m)^[\s]*[-*+]\s+/, 0: "list"}
        {match: /(?m)^[\s]*\d+\.\s+/, 0: "list"}
    ]
}