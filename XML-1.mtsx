// require MT >= 2.16.0
{
    name: ["XML (Dracula)", ".xml", ".xsd", ".xsl", ".xslt", ".svg", ".plist"]
    hide: false
    ignoreCase: false
    styles: [
        // Dracula 方案：覆盖内置风格（日间, 夜间）
        "default", #6f5a4a, #6f5a4a  // 主色
        "keyword", #d32f2f, #d32f2f  // 关键字
        "string",  #558b2f, #558b2f  // 字符串
        "comment", #9e9e9e, #9e9e9e  // 注释
    ]
    comment: {startsWith: "<!--", endsWith: "-->"}
    contains: [
        // 1. 注释（必须放在 <! 声明之前，保证同位置优先匹配）
        {
            start: {match: /<!--/}
            end: {match: /-->/}
            style: "comment"
        }
        // 2. CDATA 段
        {
            start: {match: /<!\[CDATA\[/, 0: "keyword"}
            end: {match: /\]\]>/, 0: "keyword"}
        }
        // 3. 处理指令 <?xml ... ?>
        {
            start: {match: /<\?/, 0: "keyword"}
            end: {match: /\?>/, 0: "keyword"}
            contains: [
                {match: /"[^"]*"/, 0: "string"}
                {match: /'[^']*'/, 0: "string"}
                {match: /[\w:-]+/, 0: "keyword"}
            ]
        }
        // 4. 声明 <!DOCTYPE ...> 等
        {
            start: {match: /<!/, 0: "keyword"}
            end: {match: />/, 0: "keyword"}
            contains: [
                {match: /"[^"]*"/, 0: "string"}
                {match: /'[^']*'/, 0: "string"}
                {match: /[\w:-]+/, 0: "keyword"}
            ]
        }
        // 5. 标签 <tag ...> </tag> <tag/>（属性名使用主色）
        {
            start: {match: /<\/?[\w:-]+/, 0: "keyword"}
            end: {match: /\/?>/, 0: "keyword"}
            contains: [
                {match: /"[^"]*"/, 0: "string"}
                {match: /'[^']*'/, 0: "string"}
            ]
        }
        // 6. 实体引用 &amp; &#65; &#x41;
        {match: /&(?:[a-zA-Z][a-zA-Z0-9]*|#[0-9]+|#x[0-9A-Fa-f]+);/, 0: "keyword"}
    ]
}